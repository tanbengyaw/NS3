        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0011-create-reference-schema" author="ns3">
        <sql>CREATE SCHEMA IF NOT EXISTS reference;</sql>
    </changeSet>

    <changeSet id="0011-ref-state" author="ns3">
        <createTable tableName="ref_state" schemaName="reference">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0011-ref-city" author="ns3">
        <createTable tableName="ref_city" schemaName="reference">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="state_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ref_city_state"
                             references="reference.ref_state(id)"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_ref_city_state" tableName="ref_city" schemaName="reference">
            <column name="state_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="0011-ref-postcode" author="ns3">
        <createTable tableName="ref_postcode" schemaName="reference">
            <column name="postcode" type="VARCHAR(10)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="state_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ref_postcode_state"
                             references="reference.ref_state(id)"/>
            </column>
            <column name="city_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ref_postcode_city"
                             references="reference.ref_city(id)"/>
            </column>
        </createTable>
        <createIndex indexName="idx_ref_postcode_state" tableName="ref_postcode" schemaName="reference">
            <column name="state_id"/>
        </createIndex>
        <createIndex indexName="idx_ref_postcode_city" tableName="ref_postcode" schemaName="reference">
            <column name="city_id"/>
        </createIndex>
    </changeSet>

