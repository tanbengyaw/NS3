<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0030-create-identity-schema" author="ns3">
        <sql>CREATE SCHEMA IF NOT EXISTS identity;</sql>
    </changeSet>

    <changeSet id="0030-staff-user" author="ns3">
        <createTable tableName="staff_user" schemaName="identity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="branch_id" type="BIGINT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="0030-staff-user-role" author="ns3">
        <createTable tableName="staff_user_role" schemaName="identity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="staff_user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_staff_user_role_staff_user"
                             references="identity.staff_user(id)"/>
            </column>
            <column name="role_code" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="staff_user_role" schemaName="identity"
                             columnNames="staff_user_id, role_code"
                             constraintName="uk_staff_user_role"/>
    </changeSet>

