<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0006-reg-general-info-incomplete" author="ns3">
        <addColumn tableName="reg_general_info" schemaName="registration">
            <column name="is_incomplete" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="0006-employee" author="ns3">
        <createTable tableName="employee" schemaName="registration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_employee_employer"
                             references="registration.employer(id)"/>
            </column>
            <column name="employee_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="identification_no" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="employment_start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="nationality_id" type="BIGINT"/>
            <column name="temp_employee_id" type="BIGINT"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_employee_employer" schemaName="registration" tableName="employee">
            <column name="employer_id"/>
        </createIndex>
        <createIndex indexName="idx_employee_identification_no" schemaName="registration" tableName="employee">
            <column name="identification_no"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
