<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Repair dev seed hashes when Liquibase stripped $ from bcrypt values in 0030 inserts. -->
    <changeSet id="0031-fix-staff-dev-password-hash" author="ns3">
        <sql><![CDATA[
            UPDATE identity.staff_user
            SET password_hash = '{bcrypt}$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi'
            WHERE password_hash IS NULL
               OR password_hash NOT LIKE '{bcrypt}$2a$%';
        ]]></sql>
    </changeSet>

</databaseChangeLog>
