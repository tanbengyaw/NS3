<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Audit module schema — current Hibernate mapping only (May 2026 UI).

        Source: live DB2 AUDIT dump + assist_tesing_only Hibernate hbm.xml.
        SMALLINT flags → BOOLEAN. Sequences → identity. Intra-audit FKs added.
        employer_id / sst_info_id stay soft FKs (null until Create Case auto-reg).

        Kept legacy spellings used by Hibernate: extimated_tax_exposure_rm,
        is_checked_input_tax_eligility, conclution, taxpaper_response.

        Excluded leftover live-DB columns (not in current Hibernate):
          AUDIT_CASE: task_status_date, ref_audit_type_id, offi/superv/revi rem*
          AUDIT_CASE_TAX_PAYER: is_*_tax_audit flags
          AUDIT_CASE_OFFICER: audit_case_id, is_assignee, site_visit_id
          AUDIT_PLANNING_INFO: ref_proposed_case_type_id (commented out in hbm)

        Excluded leftover live-DB tables (not current UI):
          audit_case_scope, site_visit, visit_finding, pre_audit,
          pre_audit_information, audit_sst02, audit_service_detail,
          remark_chat, remark_status_info, ref_compliance, ref_record_type,
          ref_risk_indicator, ref_site_visit_status, ref_verification_type,
          ref_visit_type. No bod_information table exists in live DB.
    -->

    <changeSet id="0045-create-audit-schema" author="ns3">
        <sql>CREATE SCHEMA IF NOT EXISTS audit;</sql>
    </changeSet>

    <changeSet id="0045-audit-case" author="ns3">
        <createTable tableName="audit_case" schemaName="audit">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="process_instance_id" type="BIGINT"/>
            <column name="case_ref_no" type="VARCHAR(30)"/>
            <column name="task_status_id" type="BIGINT"/>
            <column name="branch_id" type="BIGINT"/>
            <column name="submit_date" type="DATE"/>
            <column name="is_pre_audit_skip" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="ref_case_source_id" type="BIGINT"/>
            <column name="ref_risk_level_id" type="BIGINT"/>
            <column name="ref_audit_reason_id" type="BIGINT"/>
            <column name="extimated_tax_exposure_rm" type="DECIMAL(16,2)"/>
            <column name="period_from" type="DATE"/>
            <column name="period_to" type="DATE"/>
            <column name="objective" type="VARCHAR(1000)"/>
            <column name="exclusions" type="VARCHAR(1000)"/>
            <column name="ref_proposed_next_action_id" type="BIGINT"/>
            <column name="ref_proposed_case_type_id" type="BIGINT"/>
            <column name="review_date" type="DATE"/>
            <column name="justification" type="VARCHAR(1000)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="create_by_id" type="BIGINT"/>
            <column name="create_date" type="TIMESTAMP"/>
            <column name="update_by_id" type="BIGINT"/>
            <column name="update_date" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="audit_case" schemaName="audit" indexName="idx_audit_case_process_instance">
            <column name="process_instance_id"/>
        </createIndex>
        <createIndex tableName="audit_case" schemaName="audit" indexName="idx_audit_case_case_ref_no">
            <column name="case_ref_no"/>
        </createIndex>
        <createIndex tableName="audit_case" schemaName="audit" indexName="idx_audit_case_task_status">
            <column name="task_status_id"/>
        </createIndex>
        <createIndex tableName="audit_case" schemaName="audit" indexName="idx_audit_case_branch">
            <column name="branch_id"/>
        </createIndex>
    </changeSet>

