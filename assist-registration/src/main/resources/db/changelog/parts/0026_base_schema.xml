            <column name="address_line_1" type="VARCHAR(100)"/>
            <column name="address_line_2" type="VARCHAR(100)"/>
            <column name="address_line_3" type="VARCHAR(100)"/>
            <column name="country_id" type="BIGINT"/>
            <column name="state_id" type="BIGINT"/>
            <column name="city_id" type="BIGINT"/>
            <column name="postcode" type="VARCHAR(10)"/>
            <column name="po_box" type="VARCHAR(30)"/>
            <column name="locked_bag" type="VARCHAR(30)"/>
            <column name="wdt" type="VARCHAR(30)"/>
            <column name="address_type_id" type="BIGINT">
