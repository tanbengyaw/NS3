<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0026-create-base-schema" author="ns3">
        <sql>CREATE SCHEMA IF NOT EXISTS base;</sql>
    </changeSet>

    <changeSet id="0026-user-employer" author="ns3">
        <createTable tableName="user_employer" schemaName="base">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="application_type" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="employer_code" type="VARCHAR(20)"/>
            <column name="employer_name" type="VARCHAR(100)"/>
            <column name="registration_type_id" type="BIGINT"/>
            <column name="registration_no" type="VARCHAR(30)"/>
            <column name="full_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="identification_type" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="identification_value" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="group_of_companies" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="branch_id" type="BIGINT"/>
            <column name="employer_id" type="BIGINT"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="create_by_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="create_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="update_by_id" type="BIGINT"/>
            <column name="update_date" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="0026-temp-user-employer" author="ns3">
        <createTable tableName="temp_user_employer" schemaName="base">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="application_type" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="employer_code" type="VARCHAR(20)"/>
            <column name="employer_name" type="VARCHAR(100)"/>
            <column name="registration_type_id" type="BIGINT"/>
            <column name="registration_no" type="VARCHAR(30)"/>
            <column name="full_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="identification_type" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="identification_value" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="security_phrase" type="VARCHAR(50)"/>
            <column name="group_of_companies" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="branch_id" type="BIGINT"/>
            <column name="employer_id" type="BIGINT"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="create_by_id" type="BIGINT">
