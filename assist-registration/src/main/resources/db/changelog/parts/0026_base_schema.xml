    <changeSet id="0026-employer-mapping" author="ns3">
        <createTable tableName="employer_mapping" schemaName="base">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_employer_id" type="BIGINT"/>
            <column name="employer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="parent_employer_id" type="BIGINT"/>
            <column name="status" type="INT" defaultValueNumeric="2">
