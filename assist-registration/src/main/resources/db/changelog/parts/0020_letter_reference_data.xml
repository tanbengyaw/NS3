<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0020-reg-area-code-area-name" author="ns3">
        <addColumn tableName="reg_area_code" schemaName="registration">
            <column name="area_name" type="VARCHAR(100)"/>
        </addColumn>
        <update tableName="reg_area_code" schemaName="registration">
            <column name="area_name" value="Shah Alam (OPA)"/>
            <where>postcode = '50812'</where>
        </update>
        <update tableName="reg_area_code" schemaName="registration">
            <column name="area_name" value="Kuala Lumpur (OPA)"/>
            <where>postcode = '50000'</where>
        </update>
        <insert tableName="reg_area_code" schemaName="registration">
            <column name="branch_id" valueNumeric="1"/>
            <column name="postcode" value="53300"/>
            <column name="area_code" value="W10"/>
            <column name="area_name" value="Wilayah Persekutuan Kuala Lumpur"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="0020-ref-branch-address" author="ns3">
        <addColumn tableName="ref_branch" schemaName="reference">
            <column name="address_line1" type="VARCHAR(200)"/>
            <column name="address_line2" type="VARCHAR(200)"/>
            <column name="address_line3" type="VARCHAR(200)"/>
            <column name="postcode" type="VARCHAR(10)"/>
            <column name="city_name" type="VARCHAR(100)"/>
        </addColumn>
        <update tableName="ref_branch" schemaName="reference">
            <column name="address_line1" value="Tingkat 1, Bangunan PERKESO"/>
            <column name="address_line2" value="Jalan Sultan Ismail"/>
            <column name="postcode" value="50250"/>
            <column name="city_name" value="Kuala Lumpur"/>
            <where>id = 1</where>
        </update>
        <update tableName="ref_branch" schemaName="reference">
            <column name="address_line1" value="Tingkat 1, Wisma PERKESO"/>
            <column name="address_line2" value="Persiaran Raja"/>
            <column name="postcode" value="40000"/>
            <column name="city_name" value="Shah Alam"/>
            <where>id = 2</where>
        </update>
        <update tableName="ref_branch" schemaName="reference">
            <column name="address_line1" value="Tingkat 1, Bangunan PERKESO"/>
            <column name="address_line2" value="Jalan 219, Section 51A"/>
            <column name="postcode" value="46100"/>
            <column name="city_name" value="Petaling Jaya"/>
            <where>id = 3</where>
        </update>
        <update tableName="ref_branch" schemaName="reference">
            <column name="address_line1" value="Tingkat 1, Bangunan PERKESO"/>
            <column name="address_line2" value="Jalan Tebrau"/>
            <column name="postcode" value="80300"/>
            <column name="city_name" value="Johor Bahru"/>
            <where>id = 4</where>
        </update>
        <update tableName="ref_branch" schemaName="reference">
            <column name="address_line1" value="Tingkat 1, Bangunan PERKESO"/>
            <column name="address_line2" value="Jalan Macalister"/>
            <column name="postcode" value="10400"/>
            <column name="city_name" value="George Town"/>
            <where>id = 5</where>
        </update>
    </changeSet>

</databaseChangeLog>
