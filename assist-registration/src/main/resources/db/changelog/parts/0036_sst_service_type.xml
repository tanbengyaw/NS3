    <!-- Draft child table: service categories selected during registration -->
    <changeSet id="0036-temp-sst-service-category" author="ns3">
        <createTable tableName="temp_sst_service_category" schemaName="registration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="temp_sst_info_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sst_service_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="remark" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Permanent child table: promoted on case approval -->
    <changeSet id="0036-sst-service-category" author="ns3">
        <createTable tableName="sst_service_category" schemaName="registration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sst_info_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="employer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sst_service_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="remark" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
