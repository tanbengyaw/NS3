<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0002-sequence-no-table" author="ns3">
        <createTable tableName="sequence_no" schemaName="registration">
            <column name="name" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="next_val" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0002-sequence-no-seed" author="ns3">
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="EMPLOYER_CODE_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="NEW_REG_CASE_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="UPDATE_C1_CASE_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="UPDATE_C2_CASE_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="UPDATE_ADD_NEW_EMPLOYEE_CASE_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="UPDATE_SSN_CASE_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="SSN_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="SIP_UPDATE_C1_CASE_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="SIP_UPDATE_C2_CASE_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="SSN_FOREIGN_EMPLOYEE_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
        <insert tableName="sequence_no" schemaName="registration">
            <column name="name" value="SMK_NO_SEQ"/>
            <column name="next_val" valueNumeric="1"/>
        </insert>
    </changeSet>

    <changeSet id="0002-reg-area-code-table" author="ns3">
        <createTable tableName="reg_area_code" schemaName="registration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="branch_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="postcode" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="area_code" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_reg_area_code_lookup" schemaName="registration"
                     tableName="reg_area_code">
            <column name="branch_id"/>
            <column name="postcode"/>
        </createIndex>
    </changeSet>

    <changeSet id="0002-reg-area-code-dev-seed" author="ns3">
        <insert tableName="reg_area_code" schemaName="registration">
            <column name="branch_id" valueNumeric="2"/>
            <column name="postcode" value="50812"/>
            <column name="area_code" value="A37"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="reg_area_code" schemaName="registration">
            <column name="branch_id" valueNumeric="1"/>
            <column name="postcode" value="50000"/>
            <column name="area_code" value="A31"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="0002-temp-employer-postcode" author="ns3">
        <addColumn tableName="temp_employer" schemaName="registration">
            <column name="post_code" type="VARCHAR(10)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
