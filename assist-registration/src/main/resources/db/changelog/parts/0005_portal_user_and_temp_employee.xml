<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0005-portal-user" author="ns3">
        <createTable tableName="portal_user" schemaName="registration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="employer_id" type="BIGINT"/>
            <column name="employer_code" type="VARCHAR(30)"/>
            <column name="linked_date" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="0005-portal-user-dev-seed" author="ns3">
        <insert tableName="portal_user" schemaName="registration">
            <column name="username" value="employer"/>
            <column name="email" value="hr@acme.example"/>
        </insert>
    </changeSet>

    <changeSet id="0005-temp-employee" author="ns3">
        <createTable tableName="temp_employee" schemaName="registration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="temp_employer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_temp_employee_temp_employer"
                             references="registration.temp_employer(id)"/>
            </column>
            <column name="employee_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="identification_no" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="employment_start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="nationality_id" type="BIGINT"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP"/>
        </createTable>
        <createIndex indexName="idx_temp_employee_temp_employer" schemaName="registration"
                     tableName="temp_employee">
            <column name="temp_employer_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
