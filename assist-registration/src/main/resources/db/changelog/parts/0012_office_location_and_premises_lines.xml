<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0012-ref-branch" author="ns3">
        <createTable tableName="ref_branch" schemaName="reference">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0012-ref-postcode-office" author="ns3">
        <createTable tableName="ref_postcode_office" schemaName="reference">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="postcode" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="branch_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ref_postcode_office_branch"
                             references="reference.ref_branch(id)"/>
            </column>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_ref_postcode_office_postcode" tableName="ref_postcode_office" schemaName="reference">
            <column name="postcode"/>
        </createIndex>
    </changeSet>

