<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Incomplete auto-registration (legacy AutoRegTaxPayerWs + IncompleteAutoRegTaxCounter).
        Audit (or a stub) ingests a live employer + partial sst_info. Staff later start a
        1205-1209 completion case linked via source_sst_info_id.
    -->
    <changeSet id="0044-sst-info-auto-reg-source" author="ns3">
        <addColumn tableName="sst_info" schemaName="registration">
            <column name="tax_type" type="VARCHAR(30)"/>
            <column name="auto_registration_source" type="VARCHAR(30)"/>
            <column name="ingest_temp_employer_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="0044-reg-general-info-source-sst-info" author="ns3">
        <addColumn tableName="reg_general_info" schemaName="registration">
            <column name="source_sst_info_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
